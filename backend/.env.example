# ──────────────────────────────────────────────────────
# AI Quiz App — Backend Environment Variables
# ──────────────────────────────────────────────────────
# ローカル開発:  cp .env.example .env  して値を入力
# Render本番:   ダッシュボードの Environment > Add env var で設定
# ──────────────────────────────────────────────────────

# ── Google Gemini API ──────────────────────────────────
# 取得先: https://aistudio.google.com/app/apikey
# 無料枠: 500リクエスト/日
GOOGLE_API_KEY=your_gemini_api_key_here

# ── データベース ───────────────────────────────────────
# ローカル開発: SQLite（このまま変更不要）
DATABASE_URL=sqlite:///./quiz.db
#
# 本番 (Neon PostgreSQL): 以下の形式で置き換え
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# ── CORS ──────────────────────────────────────────────
# ローカル開発
CORS_ORIGINS=http://localhost:3000
#
# 本番: Vercel のデプロイURL に置き換え
# CORS_ORIGINS=https://your-app.vercel.app
